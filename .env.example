PORT=3000
# Conexión de la APLICACIÓN: rol sin privilegios (miembro de signage_app). Nunca el dueño ni un superusuario.
POSTGRES_URI=postgres://signage_login:signage@localhost:5432/signage
# Conexión de MIGRACIONES: el dueño del esquema. Solo la usa `npm run migrate`.
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/signage
LOG_LEVEL=info
